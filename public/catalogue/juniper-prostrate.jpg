    <script>
      // Preload the correct LCP banner for this route so the browser fetches
      // it immediately (CSS backgrounds are otherwise discovered late).
      (function () {
        var p = location.pathname;
        var img = null;
        if (p === '/' || p === '/index.html') {
          img = window.matchMedia && matchMedia('(max-width: 720px)').matches
            ? '/img/hero-mobile.webp' : '/img/hero.webp';
        } else {
          var m = window.matchMedia && matchMedia('(max-width: 760px)').matches ? '-m' : '';
          if (p.indexOf('/catalog') === 0) img = '/img/catalog-banner' + m + '.webp';
          else if (p.indexOf('/blog') === 0) img = '/img/blog-banner' + m + '.webp';
          else if (p.indexOf('/contact') === 0) img = '/img/contact-banner' + m + '.webp';
          else if (p.indexOf('/supply') === 0 || p.indexOf('/wholesale') === 0) img = '/img/supply-banner' + m + '.webp';
        }
        if (img) {
          var l = document.createElement('link');
          l.rel = 'preload'; l.as = 'image'; l.href = img;
          // fetchpriority=high: the banner is the page's LCP element and is now
          // small enough (recompressed) that prioritising it improves LCP
          // without starving first paint. (PageSpeed: "fetchpriority=high
          // should be applied to the LCP image preload request".)
          l.setAttribute('fetchpriority', 'high');
          document.head.appendChild(l);
        }
      })();
    </script>
